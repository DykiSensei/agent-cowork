# 复制成 .env 后填真实值：  cp .env.example .env
#
# .env 已在 .gitignore 里，不会被提交。
# 这个文件同时被两边读取：
#   - docker compose（自动读项目根的 .env，用于 ${VAR} 替换）
#   - 应用（cowork.config.load_env）
# 所以格式必须是 compose 兼容的：KEY=value，不要写 export，不要用 shell 展开。
#
# 优先级：真实环境变量 > .env 文件。CI / 容器里用环境变量覆盖即可。

# ---------------------------------------------------------------------------
# 模型供应商（至少填一个）
# ---------------------------------------------------------------------------

# 填哪家就用哪家，`--backend <名字>` 对应下面的变量。
# 填完跑一次 `python -m cowork.cli models` 对一遍模型 id 还在不在服务端 ——
# 那张表会无声地过期（供应商下线一个 id 时端点和 key 都还是好的）。

# DeepSeek  https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Kimi / Moonshot  https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=

# Anthropic  https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI  https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini（走 OpenAI 兼容层）  https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 阿里百炼 / 通义千问  https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# 智谱 GLM  https://open.bigmodel.cn/usercenter/apikeys
ZHIPUAI_API_KEY=

# xAI Grok  https://console.x.ai/
XAI_API_KEY=

# 字节 豆包 / 火山方舟  https://console.volcengine.com/ark
ARK_API_KEY=

# ---------------------------------------------------------------------------
# 应用侧模型选择（可选，留空用各后端的默认值）
# ---------------------------------------------------------------------------

# 直连供应商时不用设（`--backend <家>` 自带 base_url）；
# 走 LiteLLM 用 `--backend litellm`，或在这里覆盖成任意 OpenAI 兼容端点。
# 阿里百炼要用工作空间域名时也设这里。
COWORK_LLM_BASE_URL=

# 走 LiteLLM 时填 virtual key（不是供应商 key）——它承担 token_budget 强制执行
COWORK_LLM_API_KEY=

# 覆盖默认分工。留空用 cli.PROVIDERS 里那家的默认值
COWORK_ARCHITECT_MODEL=
COWORK_SUBAGENT_MODEL=
COWORK_TRIAGE_MODEL=

# 推理挡位：off / low / medium / high / max（统一词表，各家自己取整，见 llm/effort.py）
# 默认 架构师 high、Subagent medium、分诊/探查/摘要 off。
# 注意实测（§10.3.2）：只有 deepseek 的 off 和 kimi 的 max 能观测到效果，
# 中间档位在同一个提示词上区分不出来 —— 别指望调 medium 就一定省钱。
COWORK_ARCHITECT_EFFORT=
COWORK_SUBAGENT_EFFORT=
COWORK_CHEAP_EFFORT=

# ---------------------------------------------------------------------------
# 联网（两个工具：fetch_url 取已知网址 / search_web 搜）
# ---------------------------------------------------------------------------

# 总闸。**默认关** —— 取回的第三方文本会进 reasoning_trace 再进下一轮提示词，
# 那是一条提示词注入通道。设置页写的就是它。
COWORK_ALLOW_NETWORK=off

# search_web 用哪家搜索 API。留空 = zhipu（这几家里唯一把搜索单独暴露成
# API 的，不经过模型）。key 默认直接用 ZHIPUAI_API_KEY —— 已经配了智谱的人
# 什么都不用再填。只有要用另一把 key 时才设 COWORK_SEARCH_API_KEY。
COWORK_SEARCH_PROVIDER=
COWORK_SEARCH_API_KEY=

# ---------------------------------------------------------------------------
# 执行边界与工作区（全部归人，不归架构师 —— 让被隔离方给自己配边界没有意义）
# ---------------------------------------------------------------------------

# 产物落在哪的根目录。留空 = ~/cowork-workspaces
# **必须是人找得到的地方**：原来没配就 mkdtemp()，于是「我的产物在哪」没有答案
COWORK_WORKSPACE=

# `run` 能调哪些程序，逗号分隔。留空 = types.DEFAULT_BINARIES（各语言运行时）。
# **不含 shell**（sh/bash/cmd/powershell）：放进去等于白名单作废，因为 shell
# 能启动任何别的程序。撞白名单不是死路 —— 会升级给人，人可以当场放行。
COWORK_ALLOWED_BINARIES=

# 一个子任务最多走几步。0 = 不限，留空 = 60。
# 它挡的是「原地打转」—— 那类失效很便宜，token 计数拦不住
COWORK_MAX_STEPS=

# 写入侧复核（改 TaskSpec 前让复核者看一眼）。off 关掉，留空 = 开
COWORK_REVIEW_WRITES=

# ---------------------------------------------------------------------------
# 三个角色的附加提示词（**追加**在内置提示词之后，不替换它）
# ---------------------------------------------------------------------------
# 内置那段带着输出契约（必须返回符合 schema 的 JSON）和工具清单，替换掉 =
# 100% 解析失败。这里只写偏好：用什么语言、代码风格、要不要写测试。
# **多行值要转义成字面 \n**（.env 是一行一个 KEY=value），设置页会自动处理。
COWORK_ARCHITECT_PROMPT=
COWORK_REVIEWER_PROMPT=
COWORK_SUBAGENT_PROMPT=

# ---------------------------------------------------------------------------
# 基础设施（有默认值，一般不用改）
# ---------------------------------------------------------------------------

# LiteLLM 代理的管理密钥。生产环境务必换掉。
LITELLM_MASTER_KEY=sk-cowork-master
LITELLM_SALT_KEY=sk-cowork-salt-000

# Postgres DSN，供应用侧的 PostgresStore 使用
COWORK_PG_DSN=postgresql://cowork:cowork@localhost:5433/cowork
