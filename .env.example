# 复制成 .env 后填真实值：  cp .env.example .env
#
# .env 已在 .gitignore 里，不会被提交。
# 这个文件同时被两边读取：
#   - docker compose（自动读项目根的 .env，用于 ${VAR} 替换）
#   - 应用（cowork.config.load_env）
# 所以格式必须是 compose 兼容的：KEY=value，不要写 export，不要用 shell 展开。
#
# 优先级：真实环境变量 > .env 文件。CI / 容器里用环境变量覆盖即可。

# ---------------------------------------------------------------------------
# 模型供应商（至少填一个）
# ---------------------------------------------------------------------------

# DeepSeek  https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Kimi / Moonshot  https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=

# Anthropic  https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# 应用侧模型选择（可选，留空用各后端的默认值）
# ---------------------------------------------------------------------------

# 直连供应商时不用设；走 LiteLLM 时设成 http://localhost:4000/v1
COWORK_LLM_BASE_URL=

# 走 LiteLLM 时填 virtual key（不是供应商 key）——它承担 token_budget 强制执行
COWORK_LLM_API_KEY=

# 覆盖默认分工。DeepSeek 方案：架构师 reasoner，Subagent / 分诊 chat
COWORK_ARCHITECT_MODEL=
COWORK_SUBAGENT_MODEL=
COWORK_TRIAGE_MODEL=

# ---------------------------------------------------------------------------
# 基础设施（有默认值，一般不用改）
# ---------------------------------------------------------------------------

# LiteLLM 代理的管理密钥。生产环境务必换掉。
LITELLM_MASTER_KEY=sk-cowork-master
LITELLM_SALT_KEY=sk-cowork-salt-000

# Postgres DSN，供应用侧的 PostgresStore 使用
COWORK_PG_DSN=postgresql://cowork:cowork@localhost:5433/cowork
